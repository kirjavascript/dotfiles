#!/bin/sh
rsync \
    --itemize-changes \
    --out-format="%i|%n|" \
    --exclude node_modules \
    --exclude .npm \
    --exclude .cargo \
    --exclude .bun \
    --exclude .bundle \
    --exclude .xargo \
    --exclude target \
    --exclude .rustup \
    --exclude .gradle \
    --exclude '.config/chromium' \
    --exclude '.config/stremio-enhanced' \
    --exclude .rbenv \
    --exclude .stremio-server \
    --exclude .cache \
    --exclude .wine \
    --exclude .yarn \
    --exclude Android \
    --exclude Genesis \
    --exclude .android \
    --exclude Downloads \
    --exclude bin/games \
    --exclude wfh \
    --exclude '.local/share' \
    --relative \
    --recursive \
    --update \
    --delete \
    --perms \
    --owner \
    --group \
    --times \
    /home/cake /run/media/cake/internal-storage/backup
